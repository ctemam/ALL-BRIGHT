# API Backend URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# Fallback base used by ExecutionPanel (same as NEXT_PUBLIC_API_URL)
NEXT_PUBLIC_API_BASE=http://localhost:3001

# Pimlico (ERC-4337) — no frontend key: the bundler/paymaster is proxied by the
# backend at /api/pimlico/* so PIMLICO_API_KEY stays server-side in backend .env.

# Velora API (ex-ParaSwap) is called through the backend — no separate key needed here

# RPC URLs (same as backend)
NEXT_PUBLIC_ETH_RPC_URL=https://eth.merkle.io
NEXT_PUBLIC_ARB_RPC_URL=https://arb1.arbitrum.io/rpc
NEXT_PUBLIC_OP_RPC_URL=https://mainnet.optimism.io
NEXT_PUBLIC_POLY_RPC_URL=https://polygon-rpc.com
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.binance.org
NEXT_PUBLIC_AVAX_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# WalletConnect Project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
